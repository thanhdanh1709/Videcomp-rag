# ViDecomp-RAG - xem HuongDanThucHien_QueryDecomposition_MultiHop_Vietnamese.docx Buoc 1.4
# Copy thanh .env va dien gia tri that. KHONG commit .env vao git.

LLM_PROVIDER=mock
# anthropic (Claude that, qua Anthropic SDK) | openai_compatible (Ollama/vLLM) | mock
ANTHROPIC_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=local-or-secret
LLM_MODEL=claude-sonnet-5

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

VECTOR_BACKEND=faiss
QDRANT_URL=http://localhost:6333
POSTGRES_DSN=postgresql+psycopg://videcomp:videcomp@localhost:5432/videcomp

# DB_DSN la connection string SQLAlchemy that su dung (backend/app/db).
# Mac dinh SQLite local, khong can Docker. Khi chay qua docker-compose,
# doi thanh gia tri giong POSTGRES_DSN o tren (driver psycopg v3).
DB_DSN=sqlite:///./data/videcomp.db

MAX_HOPS=4
SPARSE_K=30
DENSE_K=30
RRF_K=60
RERANK_POOL=20
TOP_K_CONTEXT=5

MULTI_HOP_THRESHOLD=0.5
MAX_CORRECTIVE_ROUNDS=1

CONFIG_VERSION=exp-dev-0
